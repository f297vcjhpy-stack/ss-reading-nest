{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "an-reading-nest",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "MCP_PATH_TOKEN"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-reading-db",
      "database_id": "d96376ef-299d-4f08-a7c1-4b94741fe1ce",
      "migrations_dir": "./migrations"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "observability": {
    "enabled": false
  }
}
